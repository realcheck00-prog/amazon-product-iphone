# Supabase — browser-safe values only.
# Copy this file to `.env` (never commit `.env`) and fill in your project values.
#
# Find these in the Supabase dashboard: Project Settings → API.
#   - Project URL
#   - Publishable key  (the "sb_publishable_…" key — safe for the browser)
#
# A legacy "anon" JWT works too: either set it as the publishable key above or
# use the commented VITE_SUPABASE_ANON_KEY line. Both carry the anon role only.
#
# Never put the database password or the service-role key in this file.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---------------------------------------------------------------------------
# The onboarding form collects no card or bank details and takes no payment.
# The customer account details (username, 20-character user ID and the
# 3-digit confirmation code) are assigned later by the support team, from the
# Supabase dashboard — they are never requested from the customer.
# ---------------------------------------------------------------------------
