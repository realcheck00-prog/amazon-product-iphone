# Supabase — browser-safe values only.
# Copy this file to `.env` (never commit `.env`) and fill in your project values.
#
# Find these in the Supabase dashboard: Project Settings → API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Payment mode advertised to the UI. Leave as `demo` until a real payment
# provider is fully integrated and verified server-side.
VITE_PAYMENT_MODE=demo

# ---------------------------------------------------------------------------
# The following are NOT read by the frontend. They are secrets for the
# Supabase Edge Functions and are set with:
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=... 
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically by the
# Supabase Edge Runtime in production.
#
# Set only if you later integrate a real payment provider:
#   supabase secrets set PAYMENT_PROVIDER=stripe
#   supabase secrets set STRIPE_SECRET_KEY=sk_live_...
# ---------------------------------------------------------------------------
